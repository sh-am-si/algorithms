   "source": [
    "def fib(n: int) -> int:\n",
    "    a, b = 0, 1\n",
    "    if n == 0:\n",
    "        return a\n",
    "    elif n == 1:\n",
    "        return b\n",
    "    else:\n",
    "        for _ in range(1, n):\n",
    "            a, b = b, a + b\n",
    "        return b\n",
    "\n",
    "\n",
    "print(fib(121))"
   ]
  },
